#!/bin/sh
# Runs the app with the system's Python and GTK; the AppImage only bundles
# pure Python code.
HERE="$(dirname "$(readlink -f "$0")")"

fail() {
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="Impresora térmica" --text="$1" 2>/dev/null
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send "Impresora térmica" "$1"
    fi
    echo "$1" >&2
    exit 1
}

command -v python3 >/dev/null 2>&1 || fail "Falta Python 3. Instálalo con: sudo apt install python3"
python3 -c 'import gi, cairo; gi.require_version("Gtk", "4.0"); gi.require_version("Adw", "1")' 2>/dev/null ||
    fail "Faltan bibliotecas de GTK. Instálalas con:
sudo apt install python3-gi python3-gi-cairo gir1.2-gtk-4.0 gir1.2-adw-1"

export PYTHONPATH="$HERE/usr/share/catprinter:$HERE/usr/share/catprinter/vendor"
exec python3 -s -m catprinter_gui "$@"
